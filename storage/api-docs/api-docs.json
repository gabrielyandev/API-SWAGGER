{
    "openapi": "3.0.0",
    "info": {
        "title": "API de Itens",
        "description": "Documentação da API de Itens para o ambiente Hostinger",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:8000",
            "description": "Servidor Local"
        },
        {
            "url": "https://api.suporteourobras.com",
            "description": "Servidor de Produção"
        }
    ],
    "paths": {
        "/api/login": {
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Realiza o login e retorna o Token Bearer",
                "operationId": "222b2625838e3c57e017987f73598fda",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login realizado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "token": {
                                            "type": "string",
                                            "example": "1|laravel_sanctum_token_aqui"
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Login realizado com sucesso"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Credenciais inválidas"
                    },
                    "422": {
                        "description": "Erro de validação"
                    }
                }
            }
        },
        "/api/itens": {
            "get": {
                "tags": [
                    "Itens"
                ],
                "summary": "Lista todos os itens",
                "operationId": "4c3b86065ce3907b2d817ed6a30535f5",
                "responses": {
                    "200": {
                        "description": "Listagem de itens",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/Item"
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Itens"
                ],
                "summary": "Cria um novo item",
                "operationId": "63675e58833f47ae6d8835953374caca",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/StoreItemRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Item criado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Item"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Erro de validação"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
        "/api/itens/{id}": {
            "get": {
                "tags": [
                    "Itens"
                ],
                "summary": "Exibe detalhes de um item",
                "operationId": "86de44264fcf3d9e26f4735550458856",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Detalhes do item",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Item"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Item não encontrado"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Itens"
                ],
                "summary": "Atualiza um item existente",
                "operationId": "cc559851a23f99e8a7662c2672b63121",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateItemRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Item atualizado com sucesso",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Item"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Item não encontrado"
                    },
                    "422": {
                        "description": "Erro de validação"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Itens"
                ],
                "summary": "Remove um item",
                "operationId": "6f5221222dc86a58dd48988ece7157c5",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Item removido com sucesso"
                    },
                    "404": {
                        "description": "Item não encontrado"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "LoginRequest": {
                "title": "Login Request",
                "description": "Credenciais para obtenção do token",
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "admin@example.com"
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "example": "senha123"
                    }
                },
                "type": "object"
            },
            "StoreItemRequest": {
                "title": "Requisição para Criação de Cabeçalho de Nota",
                "required": [
                    "TIPO",
                    "DATA_EMISSAO"
                ],
                "properties": {
                    "TIPO": {
                        "type": "string",
                        "example": "SAIDA"
                    },
                    "PEDIDO_CLIENTE": {
                        "type": "string",
                        "example": "PED-2023-001"
                    },
                    "CONTROLE_DE_NOTA": {
                        "type": "integer",
                        "example": 9876
                    },
                    "DATA_EMISSAO": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2023-10-01 12:00:00"
                    },
                    "TOTAL_NOTA": {
                        "type": "number",
                        "format": "float",
                        "example": 4500.5
                    },
                    "SITUACAO": {
                        "type": "string",
                        "example": "F"
                    }
                },
                "type": "object"
            },
            "UpdateItemRequest": {
                "title": "Requisição para Atualização de Cabeçalho de Nota",
                "properties": {
                    "TIPO": {
                        "type": "string",
                        "example": "SAIDA"
                    },
                    "PEDIDO_CLIENTE": {
                        "type": "string",
                        "example": "PED-2023-001"
                    },
                    "CONTROLE_DE_NOTA": {
                        "type": "integer",
                        "example": 9876
                    },
                    "DATA_EMISSAO": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2023-10-01 12:00:00"
                    },
                    "TOTAL_NOTA": {
                        "type": "number",
                        "format": "float",
                        "example": 4500.5
                    },
                    "SITUACAO": {
                        "type": "string",
                        "example": "F"
                    }
                },
                "type": "object"
            },
            "Item": {
                "title": "Cabeçalho de Nota",
                "description": "Modelo representando os dados do cabeçalho de nota do banco Firebird",
                "required": [
                    "TIPO",
                    "DATA_EMISSAO"
                ],
                "properties": {
                    "INTERNO": {
                        "type": "integer",
                        "example": 12345
                    },
                    "TIPO": {
                        "type": "string",
                        "example": "SAIDA"
                    },
                    "PEDIDO_CLIENTE": {
                        "type": "string",
                        "example": "PED-2023-001"
                    },
                    "CONTROLE_DE_NOTA": {
                        "type": "integer",
                        "example": 9876
                    },
                    "DATA_EMISSAO": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2023-10-01 12:00:00"
                    },
                    "TOTAL_NOTA": {
                        "type": "number",
                        "format": "float",
                        "example": 4500.5
                    },
                    "SITUACAO": {
                        "type": "string",
                        "example": "F"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Insira o token obtido na rota de login",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Autenticação",
            "description": "Autenticação"
        },
        {
            "name": "Itens",
            "description": "Itens"
        }
    ]
}